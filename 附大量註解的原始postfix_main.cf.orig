# See /usr/share/postfix/main.cf.dist for a commented, more complete version

# @LC@
# the configuration procedure after installatoin can be re-triggered
# by command "dpkg-reconfigure postfix"
#
# Be sure to execute "postfix reload" to make the change effective.
# or just restart postfix by "systemctl restart postfix"
#
# this file can be modified directly or by "postconf -e 'var=value'" 
# ex. "postconf -e 'home_mailbox = Maildir/'"

smtpd_banner = $myhostname ESMTP $mail_name (Ubuntu)
biff = no

# appending .domain is the MUA's job.
append_dot_mydomain = no

# Uncomment the next line to generate "delayed mail" warnings
#delay_warning_time = 4h

readme_directory = no

# See http://www.postfix.org/COMPATIBILITY_README.html -- default to 2 on
# fresh installs.
compatibility_level = 2

# @LC@
# install certbot and run standalone plugin which is a standalone web server to handle 
# http-01 challenge to finish acme handshake. 
#   1. apt install certbot
#   2. open TCP port 80 (Letsencrypt performs http challenge on it.)
#      Do it using iptables or ufw. also remember to open it from Azure.
#           ex.    ufw allow postfix 
#               or ufw allow 80
#   3. certbot certonly --standalone --rsa-key-size 4096 --agree-tos 
#           --preferred-challenges http -d <domain>
#   4. certbot saves cert/key got under /etc/letsencrypt/live/keys/<domain>/*.
#      Modify "smtpd_tls_cert_file" & "smtpd_tls_key_file" in "main.cf" accordingly.
#   5. run "systemctl restart postfix" to restart postfix.
#   6. certs got from letsencrypt will expire in 90 days.
#      certbot will auto renew certs which will expire in 30 days by cron.
#      the cron settings were in /etc/cron/cron.d/certbot 

# TLS parameters
smtpd_tls_cert_file=/etc/ssl/certs/ssl-cert-snakeoil.pem
smtpd_tls_key_file=/etc/ssl/private/ssl-cert-snakeoil.key
# @LC@ 
# 'smtpd_use_tls=yes', meaning opportunistic TLS by STartTLS offered. This is Obsolete.
# use 'smtpd_tls_security_level = none|may|encrypt' instead. 
# 'none' means TLS not used.
# 'may' means StartTLS offered, but not necessarily adopted by client.
# 'encrypt' means SSL/TLS is required. 
#smtpd_use_tls=yes
smtpd_tls_security_level = encrypt

smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

# See /usr/share/doc/postfix/TLS_README.gz in the postfix-doc package for
# information on enabling SSL in the smtp client.

smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination
myhostname = ubuntu1804.localdomain

# @LC@
# "myorigin": What domain name to use in "outbound" mail, can be 
#   ex1: myorigin = $myhostname (default: send mail as "user@$myhostname")
#   ex2: myorigin = $mydomain   (probably desirable: "user@$mydomain")
#   ex3: myorigin = /etc/mailname (the file content is domainname like "mymaildomain.com")
#         Debian specific: Specifying a file name will cause the first line of that 
#                          file to be used as the name.  The Debian default is 
#                          /etc/mailname.
#
# "mydestination": what 'local domains' this machine will deliver "locally", instead of forwarding 
#                 to another machine. 
#   ex1: default setting. 
#        mydestination = $myhostname localhost.$mydomain localhost
#   ex2: domain-wide mail server.
#        mydestination = $myhostname localhost.$mydomain localhost $mydomain
#   ex3: host with multiple DNS A records.
#        mydestination = $myhostname localhost.$mydomain localhost www.$mydomain ftp.$mydomain
#
myorigin = /etc/mailname
mydestination = $myhostname, ubuntu1804, localhost.localdomain, localhost

# @LC@
# "mynetworks": What clients to relay mail from.
#   By default Postfix will forward mail "from" clients in authorized network blocks to 
#   any destination. Authorized networks are defined with the "mynetworks" configuration 
#   parameter. The current default is to authorize the local machine only.
#
# "relay_domains": What destinations to relay mail from unknown clients to.
#   ex1: relay_domains = $mydestination (default)
#   ex2: relay_domains =                (safe: never forward mail from strangers)
#   ex3: relay_domains = $mydomain      (forward mail to my domain and subdomains)
#
# "relayhost": What delivery method (ourgoing) - direct or indirect
#   ex1: relayhost =                   (default: direct delivery to Internet/ by lookup DNS MX record?)
#   ex2: relayhost = $mydomain         (deliver via local mailhub)
#   ex3: relayhost = [mail.$mydomain]  (deliver via local mailhub. "[]" eliminates DNS MX lookups)
#   ex4: relayhost = [mail.isp.tld]    (deliver via provider mailhub)
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128

# @LC@
# we will relay outgoing mails to Brevo in real server implementation.
#relayhost = 

# @LC@
# Postfix can handle 5 domain address classes :
#
#   1. local domain :
#      mail address format : <local_linux_user>@<domains_defined_in_'$mydestination'>
#      basically this means local linux users.
#      "$mailbox_command" can be used to change default transport of mails for local users.
#      refer to "local(8)" for more details.
#      ex. to let Dovecot-LDA deliver mails of local users, 
#          --- / etc/postfix/main.cf ---
#          mailbox_command = /usr/lib/dovecot/dovecot-lda -f "$SENDER" -a "$RECIPIENT" -d "$USER"
#
#   2. virtual alias domain : (hosted domain, type 1)
#      mail addresses "MAPPED" to 
#        2-1) local_linux_user, or 
#        2-2) address in other domains with DNS MX record pointing to this machine.
#
#      "$virtual_alias_maps", "$virtual_alias_domains":
#          Define the "map" and virtual domains to handle. 
#          BUT, DON'T list domains in $mydesitnation into $virtual_alias_domains too!
#          
#        ex. ---/etc/postfix/main.cf---
#            mydestination = local.domain
#            virtual_alias_domains = hosted_domain1 hosted_domain2
#            virtual_alias_maps = hash:/etc/postfix/virtualmap
#            ---/etc/postfix/virtualmap---
#            adr1@hosted_domain1 LocalLinuxUserX
#            adr2@hosted_domain2 adrY@domainY
#
#        * NOTE *
#        After trial, the target in the virtual alias map entry must be addressible.
#        in our test we map "postmaster@mymaildomain.com" to "notroot" like below:
#           ---/etc/postfix/main.cf ---
#           virtual_alias_domains = mymaildomain.com
#           virtual_alias_maps = hash:/etc/postfix/virtual_alias_maps
#           ---/etc/postfix/virtual_alias_maps (with /etc/aliases empty) ---
#           postmaster@mymaildomain.com notroot
#
#        but when we send mail to postmaster@mymaildomain.com, postfix complains with log :
#           ... to=<notroot@mymaildomain.com>, orig_to=<postmaster@mymaildomain.com>,
#               ... status=bounced (User unknown in virtual alias table)
#
#        it looks like postfix recognize "notroot" as "notroot@mymaildomain.com", 
#        and postfix doesn't know how to deliver it, because $mydestination did not have it.
#        to fix this, either with $mydomain as "mymaildomain.com" (this conflicts to our original 
#        intention to keep local domain independent), or had "notroot" as "notroot@localhost".
#
#      AND NOTICE : virtual_alias_map file cannot support internet mail list management service 
#      directly, like majordomo. To implement maillist, direct virtual maillist to 
#      a legacy target (delivered by local delivery agent) in "/etc/alias".
#      ie. Use "virtual_alias_map" and "alias_map" together.
#      ex.
#            --- /etc/postfix/main.cf ---
#            alias_maps = hash:/etc/aliases
#            alias_database = hash:/etc/aliases
#            virtual_alias_maps = /etc/postfix/virtual
#         
#            --- /etc/postfix/virtual ---
#            mail_list1@domainA   local_maillist1_alias
#
#            --- /etc/aliases ---
#            local_maillist1_alias:    usr1@domainB, usr2@domainC, ...
#
#      *NOTE*
#      "postmap" should be used to sync ALL tables like virtual_alias_map, transport_map, ... 
#      into db files (like /etc/postfix/virtualmap.db...) before "systemctl restart postfix"
#      or "postfix reload".
#      It can also be used to query alias for a specific mail address.
#        # to sync updated content of virtual_alias_map file
#        postmap <mapfile>
#        # to query alias target of a mail address
#        post -q <alias_mail_adr> hash:<mapfile>  
#
#   3. virtual mailbox domain : (hosted domain, type 2)
#      hosted mail addresses in other domains with their mailboxes stored in this machine.
#
#      "$virtual_mailbox_domains" :
#          Define the "recepient list" and virtual domains to handle. 
#          BUT, DON'T list domains in $mydesitnation or "$virtual_alias_domains" 
#          into $virtual_mailbox_domains too!
#
#      "$virtual_mailbox_base", "$virtual_mailbox_maps" :
#          Defines recepient list and their mailbox location. 
#          the mail boxes were placed under the path defined by 
#              <prefix in $virtual_mailbox_base>/<suffix in $virtual_mailbox_maps>
#
#      "$virtual_uid_maps", "$virtual_gid_maps", "$virtual_minimum_uid":
#          Defines the mailbox's owner uid/gid, and minimum to start with.
#          In the following example all the virtual mailboxes are owned by a fixed 
#          uid and gid 5000. It can be a map file if need to define each of them.
#
#        ex. ---/etc/postfix/main.cf---
#            mydestination = local.domain
#            virtual_mailbox_domains = hosted_domain1 hosted_domain2
#            virtual_mailbox_base = /var/mail/vhosts
#            virtual_mailbox_maps = hash:/etc/postfix/vmailbox
#            virtual_minimum_uid = 100      
#            virtual_uid_maps = static:5000
#            virtual_gid_maps = static:5000
#             
#            ---/etc/postfix/vmailbox---
#            usrX@hosted_domain1    hosted_domain1/usrX     # a file if mbox format
#            usrY@hosted_domain2    hosted_domain2/usrY/    # a dir if Maildir format
#            # catch-all by '<@domain>'
#            @hosted_domain2        hosted_domain2/catchall/
#
#   4. relay domain : 
#      mail address domains with their DNS MX pointing to this machine, and this machine
#      just forward received mails out again.
#
#      "$relay_domains", "relay_recipient_maps" :
#          Defines recepient list and target to forward their mails to.
#
#   5. default domain :
#      all the mail addresses other than the previous 4 classes. 
#      By default Postfix just send them out via internet directly. 
#
#   auto-reply 
#
#      Per the 5 classes of domains there are default delivery agents (or called transports).
#      we can define custom transport types (ex. autoreply) for mail addresses needing autoreplies, 
#      which pipe the received mails to a unix process with sender, mail adr as arguments, 
#
#      ex. # specify a transport info lookup table - using "$transport_maps" in "main.cf".
#          /etc/postfix/main.cf:
#              transport_maps = hash:/etc/postfix/transport
#
#          # specify mail addresses needing custom transport types.
#          # Notice the format is "mail_adr transport_type:[next_hop]". 
#          # "next hop" is optional & transport-speific, the info helping transport to deliver mail.
#          # here transport_type is "autoreply", no "next_hop" specified. 
#          /etc/postfix/transport:
#              autoreply.mydomain.tld  autoreply:   
#
#          # Custom transport info was specified in "/etc/postfix/master.cf" (NOT "main.cf" !)
#          /etc/postfix/master.cf:
#              # =============================================================
#              # service type  private unpriv  chroot  wakeup  maxproc command
#              #               (yes)   (yes)   (yes)   (never) (100)
#              # =============================================================
#              autoreply unix  -       n       n       -       -       pipe 
#                  flags= user=nobody argv=/path/to/autoreply $sender $mailbox
#
# The old, compatible way to handle received mails - /etc/aliases.
# 
#   This way only handles "local domain" and "virtual map domain" classes, and 
#   mixes the 2 classes by defining other domains to $mydestinatin too.
#
#   "$alias_map", "alias_database", "$alias_domains"
#       Define the valid recepients and domains to handle.
#
#   "/etc/alias" : the table that directs mail to a human person
#  
#       Run cmd "postconf alias_maps" to find out where the dir located, usually /etc/alias.
#       Run cmd "newaliases" after changing the aliases file. 
#       "newaliases" will index content of "/etc/aliases" & save result in "/etc/aliases.db" the data and 
#
#       content format : see "man aliases". A typical definition line looks like 
#           name: value1, value2, ...
#
#       where "name" is a local address, "value" contains one or more of the following:
#         case1: address 
#                Mail is forwarded to RFC822-compatible address
#         case2: /file/name
#                Mail  is  appended  to  /file/name. To dispose of unwanted  mail, deflect it to /dev/null.
#         case3: |command
#                Mail is piped into command.
#         case4: :include:/file/name
#                Mail is sent to the  destinations  listed  in  the  named  file.
#
#   ex. ---/etc/aliases---
#       usrX                 usrY, usrZ@other_domain1
#       usrY@other_domain2   usrT@other_domain3
#   ex:
#     # postmaster must exist.
#     postmaster: you
#     root: you
#

# @LC@
# let's map virtual accounts of mymaildomain.com to local accounts.
#virtual_alias_domains = mymaildomain.com
#virtual_alias_maps = hash:/etc/postfix/virtualmap

# @LC@
# the old way, control mail address class via '/etc/aliases' and sync by 'newaliases' cmd.

# @LC@
# Postfix system reports problems to the "postmaster" alias. it's configurable. 
# The default is to report only serious problems (resource, software) to postmaster:
# "notify_classes" can be used here.
#   ex: notify_classes = resource, software
#

# @LC@
# /etc/syslog.conf : Control syslog logging classes, levels and logfile names for postfix
#
#   1. After changing syslog.conf, be sure to send a "HUP" signal to the syslogd process.
#   2. on Linux you need to put a "-" character before the pathname, e.g., -/var/log/maillog, 
#      otherwise the syslogd process will use more system resources than Postfix
#
#   ex: /etc/syslog.conf:
#         mail.err    /dev/console
#         mail.debug  /var/log/maillog
#
#   for maintenance it is a good idea to run every night before the syslog files are 
#   rotated:
#
#   ex: postfix check
#       egrep '(reject|warning|error|fatal|panic):' /some/log/file
#
# Running Postfix daemon processes chrooted
#
#   Sites with high security requirements should consider to chroot all daemons 
#   that talk to the network: the smtp(8) and smtpd(8) processes, and perhaps also 
#   the lmtp(8) client. 
#   By default /etc/postfix/master.cf file specifies that no Postfix daemon runs chrooted.
#   A chrooted daemon resolves all filenames relative to the Postfix queue directory 
#   (/var/spool/postfix). you almost certainly need to configure syslogd so that it 
#   listens on a socket inside the Postfix queue directory. 
#
#     ex: syslogd -a /var/spool/postfix/dev/log

# @LC@
# "proxy_interfaces" - Proxy/NAT external network addresses
# 
#    If you run a Postfix server behind a proxy or NAT, you need to configure 
#    the proxy_interfaces parameter and specify all the external proxy or NAT 
#    addresses that Postfix receives mail on. You may specify symbolic hostnames 
#    instead of network addresses. 
#
#    ex: proxy_interfaces = 1.2.3.4 (the proxy/NAT external network address)

# @LC@
# set the mail storing format. 
# "mbox" : All mails of non-root user are stored as a single file "~/mbox"
#          the built-in mail client only support this format.
# "maildir" : Each mail of non-root user is stored as single file 
#             under dir "~/maildir/[new|tmp|cur]"
#             the built-in mail client cannot handle this. we have to install "s-nail".
#             besides, make sure the following statements existing in "/etc/s-nail.rc":
#               # allows the client to open even with an empty inbox
#               set emptystart
#               # sets the Maildir directory to the internal folder variable
#               set folder=Maildir
#               # creates a sent mbox file for storing sent mail within whichever 
#               # directory is set as the folder variable, in this case Maildir
#               set record=+sent
#
home_mailbox = Maildir/

# @LC@
# let's limit mailbox size of each local user is 100M
mailbox_size_limit = 1000000

recipient_delimiter = +
inet_interfaces = all
inet_protocols = all

# @LC@
# Enable Dovecot's SASL implementation
#
# smtpd_sasl_type : 
#    By default the Postfix SMTP server uses the Cyrus SASL implementation.
# smtpd_sasl_path :
#    For SASL communication via UNIX-domain socket.
#    A pathname relative to Postfix queue directory, so that to work whether or not 
#    the Postfix SMTP server runs chrooted.
# smtpd_sasl_path :
#    For  SASL communication via TCP socket communication.
#    ex. smtpd_sasl_path = inet:127.0.0.1:12345
# smtpd_sasl_auth_enable :
#    enable SASL auth
# broken_sasl_auth_clients :
#    Per RFC the postfix's capability will be prompt when connecting by the following form:
#        "250-AUTH DIGEST-MD5 PLAIN CRAM-MD5 ..."
#    Some legacy clients like Outlook/OutlookExpress don't understand it. instead, they want
#        "250-AUTH=DIGEST-MD5 PLAIN CRAM-MD5 ..."
#    this config (broken_sasl_auth_clients) lets Postfix repeat the AUTH statement for them,
#    like :  
#        ...
#        250-AUTH DIGEST-MD5 PLAIN CRAM-MD5
#        250-AUTH=DIGEST-MD5 PLAIN CRAM-MD5220-AUTH=xxx
#
#    After set this up, restart postfix and test it by:
#        $ telnet server.example.com 25
#        ...
#        220 server.example.com ESMTP Postfix
#        
#        (type in) EHLO ...(any string standing for a client, ex. EHLO clientX)
#        250-server.example.com
#        250-PIPELINING
#        250-SIZE 10240000
#        250-AUTH DIGEST-MD5 PLAIN CRAM-MD5
#        ...
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
broken_sasl_auth_clients = yes

# @LC@
# Configure SMTP Server policy
#
# For "not TLS-encrypted" SMTP sessions 
#
#    smtpd_sasl_security_options :
#       Used to define security policies. Some SASL mechanism properties available :
#         noanonymous	: Don't use mechanisms that permit anonymous authentication.
#         noplaintext	: Don't use mechanisms that transmit unencrypted username and password 
#                         information.
#         nodictionary: Don't use mechanisms that are vulnerable to dictionary attacks.
#         forward_secrecy: Require forward secrecy between sessions 
#                          (breaking one session does not break earlier sessions).
#         mutual_auth	: Use only mechanisms that authenticate both the client and the server 
#                         to each other.
#
#       ex. at least there should be 'noanonymous'.
#             smtpd_sasl_security_options = noanonymous
#
#           or A more sophisticated policy - allows plaintext mechanisms, but only over a 
#           TLS-encrypted connection:
#             smtpd_sasl_security_options = noanonymous, noplaintext
#             smtpd_sasl_tls_security_options = noanonymous
#
# for "TLS-encrypted" SMTP sessions
#
#    smtpd_sasl_tls_security_options :
#       Used to define security policies for TLS-encrypted SMTP sessions.
#       By default we should copy the settings from the unencrypted session:
#
#       ex. smtpd_sasl_tls_security_options = $smtpd_sasl_security_options
#
#    smtpd_tls_auth_only : 
#       To offer SASL authentication only after a TLS-encrypted session has been established.
#
#       ex. smtpd_tls_auth_only = yes
#
# Enabling SASL authorization in the Postfix SMTP server
#
#    smptd_recipient_restrictions :
#       Define What rights to authorize the user who passed SASL authentication.
#       Notice this is MUST and required because these permissions are not enabled by default.  
#       Access rights available here :
#         permit_mynetworks : 
#             Permit the request when the client IP address matches any network
#             or network address listed in $mynetworks
#         permit_sasl_authenticated :
#             Permit the request when the client is successfully authenticated via the RFC 
#             4954 (AUTH) protocol (SMTP service extension for SASL)
#         reject_unauth_destination :
#             Reject the request unless 
#               1) postfix is relay (rcv domain matches $relay_domains)
#               2) postfix is the final destination (rcv matches $mydestination, 
#                  $inet_interfaces, $proxy_interfaces, $virtual_alias_domains, 
#                  or $virtual_mailbox_domains
#
#       ex. smptd_recipient_restrictions = 
#               permit_mynetworks,permit_sasl_authenticated,reject_unauth_destination 
smptd_recipient_restrictions = permit_mynetworks,permit_sasl_authenticated,reject_unauth_destination 

# @LC@
# specify transport agent for virtual class address as dovecot
# and let postfix hosts mailboxes locally for mails with destination domain as specified.
virtual_transport = dovecot
virtual_mailbox_domains = mymaildomain.com
# Let's enable virtual alias maps as well to map "postmaster/root@mymaildomain.com" to local 
# postmaster/root which are defined in /etc/aliases and mapped to notroot.
# remember to exexute "postmap /etc/postfix/virtualmap" and "newaliases" first before 
# restarting postfix.
virtual_alias_maps = hash:/etc/postfix/virtualmap

# @LC@
# the following line is needed only when we want to use dovecot-lda for system users also.
# make Dovecot-LDA as our local delivery agent and with userdb looking up enabled for quota check.
# however after trial, use dovecot-lda here can work, but it takes very long time to sync.
# With this cmd commented out, new mail arrived right away. 
# But with this enabled, it takes several minutes to sync.
# so let's use default local delivery agent instead of using dovecot-lda for local users.
# mailbox_command = /usr/lib/dovecot/dovecot-lda -f "$SENDER" -a "$RECIPIENT" -d "$USER"

# @LC@
# with port 25 blocked by most ISPs (like Azure), we cannot send out mails to other mail servers
# directly, but need a relay host to achieve it like Brevo.
# Here we configures 
# 1. "relayhost", with outgoing port specified as 587
#    notice "relayhost" is not related to relay address domain (relay_domains and relay_transport)
#    relay_domains and relay_transport are controlling incoming mails, but relayhost is controlling 
#    outgoing mails.
#    the host part should be enclosed by [], meaning "don't do MX lookup" according to mail 
#    destination. just send th eoutgoing mail to the specified relay server.
#
#    ex. relayhost = [smtp-relay.Brevo.com]:587
#
# 2. smtp client (instead of smtpd, where it is a server) to relay outgoing mails to 
#    Brevo, another mail server, and with sasl password enabled when contacing Brevo.
#
#    Also remember to execute postmap after changing "sasl_passwd" to update "sasl_passwd.db"
#    And remember to change mode of these 2 files as 600 so that only root can access it.
#
#    ex. --- /etc/main.cf ---
#        smtp_sasl_auth_enable = yes
#        smtp_sasl_password_maps = hash:/etc/postfix/client_sasl_passwd
#        smtp_sasl_security_options = noanonymous
#        smtp_tls_security_level = required
#        header_size_limit = 4096000
#
#        $ postmap /etc/postfix/client_sasl_passwd
#        $ chmod 600 /etc/postfix/client_sasl_passwd /etc/postfix/client_sasl_passwd.db
#
relayhost = [smtp-relay.brevo.com]:587
smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = hash:/etc/postfix/client_sasl_passwd
smtp_sasl_security_options = noanonymous
smtp_tls_security_level = encrypt
header_size_limit = 4096000


